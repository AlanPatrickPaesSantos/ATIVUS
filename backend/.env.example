NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sigat
SESSION_COOKIE_SECURE=false
# Use "none" with SESSION_COOKIE_SECURE=true when the hosted frontend and backend are on different origins.
SESSION_COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_REGISTRATION=5
SESSION_ABSOLUTE_TTL_MS=43200000
SESSION_IDLE_TTL_MS=1800000
ALLOWED_ORIGINS=http://localhost:5173
# Attachment storage: local disk (padrão) ou s3 (futuro, requer credenciais — NÃO conectar sem autorização).
# ATTACHMENT_STORAGE_DRIVER=local
# ATTACHMENT_STORAGE_DIR=./var/attachments
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# Optional, only for synthetic homologation bootstrap:
# HOMOLOGATION_SEED_PASSWORD=change-me-for-homologation
