NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sigat
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_REGISTRATION=5
SESSION_ABSOLUTE_TTL_MS=43200000
SESSION_IDLE_TTL_MS=1800000
ALLOWED_ORIGINS=http://localhost:5173
# Optional, only for synthetic homologation bootstrap:
# HOMOLOGATION_SEED_PASSWORD=change-me-for-homologation
