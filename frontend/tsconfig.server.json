{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "./spa-server-out",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["spaStaticServer.ts"]
}