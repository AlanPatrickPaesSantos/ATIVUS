{
  "name": "sigat-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "start:spa": "node spa-server-out/spaStaticServer.js",
    "test": "vitest --exclude e2e/** --exclude e2e-real/**",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real-backend.config.ts",
    "verify": "npm run typecheck && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "5.102.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
